{% extends 'base.html.twig' %}
{% block title %}Mot de passe oublié{% endblock %}
{% block body %}
    <h1>Mot de passe oublié</h1>
    {% if error %}<div class="warn">{{ error }}</div>{% endif %}

    {% if step == 'email' %}
        <form method="post">
            <div>Email<br><input type="email" name="email"></div>
            <button type="submit">Continuer</button>
        </form>
    {% elseif step == 'question' %}
        <p>Question secrète : <strong>Quel est le nom de votre animal ?</strong></p>
        <form method="post">
            <input type="hidden" name="email_hidden" value="{{ user.email }}">
            <div>Réponse<br><input type="text" name="answer"></div>
            <button type="submit">Valider</button>
        </form>
    {% elseif step == 'done' %}
        <div class="warn">
            Votre nouveau mot de passe est : <code>{{ revealedPassword }}</code>
            (affiché en clair pour la démonstration — en pratique il devrait être envoyé par un canal séparé).
        </div>
        <p><a href="{{ path('app_login') }}">Se connecter</a></p>
    {% endif %}
{% endblock %}
