{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
    <h1>Connexion</h1>
    {% if error %}<div class="warn">{{ error }}</div>{% endif %}
    <form method="post">
        <div>Email<br><input type="email" name="email"></div>
        <div>Mot de passe<br><input type="password" name="password"></div>
        <div><label><input type="checkbox" name="remember_me" value="1"> Se souvenir de moi</label></div>
        <button type="submit">Se connecter</button>
    </form>
    <p><a href="{{ path('app_forgot_password') }}">Mot de passe oublié ?</a> · <a href="{{ path('app_register') }}">Créer un compte</a></p>
{% endblock %}
