{% extends 'base.html.twig' %}
{% block title %}A03 - Injection SQL{% endblock %}
{% block body %}
    <span class="cat">OWASP A03:2021 - Injection</span>
    <h1>Recherche de factures</h1>
    <form method="get">
        <div>Recherche (libellé)<br><input type="text" name="q" value="{{ q }}" style="width:100%"></div>
        <button type="submit">Rechercher</button>
    </form>
    {% if sql %}
        <p>Requête SQL exécutée (concaténation directe, non préparée) :</p>
        <pre>{{ sql }}</pre>
        <table>
            <tr><th>ID</th><th>Libellé</th><th>Montant</th></tr>
            {% for r in results %}
                <tr><td>{{ r.id }}</td><td>{{ r.label }}</td><td>{{ r.amount }}</td></tr>
            {% endfor %}
        </table>
    {% endif %}
    <p><a href="{{ path('lab_a03_comments') }}">Voir la démo XSS stockée →</a> ·
       <a href="{{ path('lab_a03_ping') }}">Voir la démo injection de commande →</a></p>
{% endblock %}
